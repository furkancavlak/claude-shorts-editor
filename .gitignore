# kullanıcının kişisel tarz defteri: bu bilgisayarda kalır, GitHub'a gitmez (TARZ.md)
tarzim/

# beğendiğin videolar (alet/ALETLER.md "Referans çalış"): başkasının videosu, depoya girmez
referans/

# panelin işleri: oyun görüntüsü ve kişisel ses içerir; yalnız boş klasör işareti depoda
panel/isler/*
!panel/isler/.gitkeep
panel/calisiyor.pid
panel/panel-cikti.txt

# kurulum_testi.py'nin çıktıları (her çalıştırma yeni bir alt klasör)
kurulum-testi/

# Python önbelleği
__pycache__/
*.pyc

# render çıktıları: sahnelerin render/ klasöründe yalnız mp4'ler durur (video başına birkaç on MB).
# HyperFrames (0.8.140) kendi önbelleğini (Chrome, yazı tipleri; ~640 MB) depo dışında, ~/.cache/hyperframes içinde tutar;
# .cache/ satırı başka bir sürüm önbelleği sahne klasörüne yazarsa diye durur.
render/
.cache/

# Node paketleri (HyperFrames vb. kullanıcı kendi kurar)
node_modules/

# işletim sistemi dosyaları
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
